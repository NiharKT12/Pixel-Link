# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/pixellink

# Redis connection string (Redis Cloud, or redis://localhost:6379 locally).
# OPTIONAL: leave unset to run without a cache - MongoDB then serves both the
# lookups and the id counter. Slower, but fully functional.
REDIS_URL=redis://default:<pass>@<host>:<port>

# Port the API listens on
PORT=5000

# How long redirects stay cached, in seconds
CACHE_TTL=3600

# Public origin that short links are built from (no trailing slash).
# Leave this COMMENTED OUT in production - the code already defaults to
# https://pixink.vercel.app. Setting it to localhost on a deployed server is
# what makes the site hand out http://localhost links.
# Uncomment only for local development:
# BASE_URL=http://localhost:5000

# Browser origin allowed to call the API. Leave unset to allow any origin
# (local development only).
FRONTEND_URL=http://localhost:3000

# Shared secret for GET /api/urls. Unset means the endpoint stays closed.
ADMIN_KEY=change-me

# Signs session cookies. REQUIRED for accounts/login - without it every
# /api/auth/* request returns 503 rather than signing with a default.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this logs everyone out.
JWT_SECRET=

# Promotes this already-registered account to admin at boot. Register the
# account normally first, then restart. No admin password lives here.
ADMIN_EMAIL=

# Proxies in front of the app, for correct client-IP detection. Render
# alone is 1; with the API also proxied through Vercel it is 2. Too low and
# every visitor shares one rate-limit bucket. Check with GET /debug/ip.
TRUST_PROXY_HOPS=1

# How many days a link made by a signed-out visitor survives before MongoDB
# deletes it. 0 (the default) disables expiry entirely, so this is also the
# kill switch - no deploy needed to turn it off.
# Links owned by an account NEVER expire, and links created before accounts
# existed are never touched.
GUEST_LINK_TTL_DAYS=0

# Enables the admin bulk-delete endpoint. Off unless set to exactly "true".
# This is irreversible and there is no backup - leave it off until needed.
ALLOW_DELETE_ALL=false
